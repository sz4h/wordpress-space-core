{
    "name": "space-zone/space-core",
    "description": "Space Core – a modular WordPress core plugin by Space Zone",
    "version": "2.0.0",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Ahmed Safaa",
            "email": "info@sz4h.com",
            "homepage": "https://sz4h.com"
        }
    ],
    "require": {
        "php": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "Space\\Core\\": "src/"
        },
        "files": [
            "helpers/helpers.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
